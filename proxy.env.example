# Copy this file to proxy.env and fill in credentials locally.
SERVER_IP=
UUID=
PUBLIC_KEY=
SHORT_ID=

REALITY_SERVER_NAME=dl.google.com
PROXY_PORT=7890

# Необязательно: второй сервер (RU). Если RU_SERVER_IP задан, всё, что не
# в списке AI-сервисов (OpenAI, Anthropic, JetBrains), идёт через RU, остальное через USA.
# RU_SERVER_IP=
# RU_UUID=
# RU_PUBLIC_KEY=
# RU_SHORT_ID=
# RU_REALITY_SERVER_NAME=dl.google.com
