# Copy this file to proxy.env and fill in credentials locally.
SERVER_IP=
UUID=
PUBLIC_KEY=
SHORT_ID=

REALITY_SERVER_NAME=dl.google.com
PROXY_PORT=7890

# Ожидаемый внешний IP для проверки установщиком. Для цепочки клиент → NL → USA
# укажите IP США (108.61.222.91), иначе install.sh завершится с кодом 6.
# Если не задан, берётся значение SERVER_IP.
# EXPECTED_EXIT_IP=

# Необязательно: второй сервер-релей (RU, NL или любой другой). Если RU_SERVER_IP
# задан, всё, что не в списке AI-сервисов (OpenAI, Anthropic, JetBrains), идёт через
# этот сервер, а AI-сервисы — через USA. CHAIN_MODE=1: весь трафик клиента идёт только
# на релей, а он сам отправляет AI-домены на USA (см. README «Альтернативные схемы»).
# RU_SERVER_IP=
# RU_UUID=
# RU_PUBLIC_KEY=
# RU_SHORT_ID=
# RU_REALITY_SERVER_NAME=dl.google.com
# CHAIN_MODE=0
