# Скопируйте в .env в корне репозитория (он в .gitignore) или экспортируйте переменные.
# Здесь только порты, пути и имя образа. Секретов в этом файле нет.
KIT_UI_PORT=4050
KIT_PROXY_PORT=7890
# KIT_SSH_KEY необязателен. Нужен только для обнаружения входов на NL; без него доступен импорт ссылок.
# Ключ только для этого NL (отдельный, не основной). Создайте: ssh-keygen -t ed25519 -N '' -f ~/.ssh/nl_proxy
# Монтируется в контейнер только для чтения. Без переменной подключается пустой placeholder docker/no-key.
# KIT_SSH_KEY=/home/you/.ssh/nl_proxy
# Имя образа (по умолчанию mihomo-proxy-kit:local). Меняйте только для тестов.
KIT_IMAGE=mihomo-proxy-kit:local
